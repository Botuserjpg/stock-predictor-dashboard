# Flask/runtime
FLASK_ENV=production
LOG_LEVEL=INFO
# text (default, human-readable) or json (one object per line for log shippers)
LOG_FORMAT=text
SECRET_KEY=
# Bind address: defaults to 0.0.0.0 in production, 127.0.0.1 otherwise.
HOST=0.0.0.0
PORT=5000
# Set true on a public portfolio deployment to make / show a read-only dashboard
# preview for recruiters. Account and write features remain authenticated.
PUBLIC_DEMO=false
# Secure session cookies over HTTPS only (default: true when FLASK_ENV=production).
SESSION_COOKIE_SECURE=true

# Reverse proxy trust & Content-Security-Policy
# Comma-separated IPs/CIDRs of proxies allowed to set X-Forwarded-For
# (e.g. "127.0.0.1, ::1" or your load balancer). Empty = header ignored,
# which also makes IP spoofing impossible.
TRUSTED_PROXIES=
# Report-only by default; set true once all inline scripts are externalized.
CSP_ENFORCE=false

# Prometheus metrics endpoint (/metrics): disabled unless enabled here.
# When METRICS_TOKEN is set, scrapes must present it via X-Metrics-Token.
METRICS_ENABLED=false
METRICS_TOKEN=

# Financial data APIs
NEWSAPI_KEY=
ALPHAVANTAGE_KEY=
FINNHUB_KEY=
FMP_KEY=
POLYGON_KEY=
TIINGO_KEY=
GNEWS_KEY=

# Social/sentiment APIs
TWITTER_BEARER_TOKEN=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=

# Optional alternative data
RAVENPACK_KEY=
ACCERN_KEY=

# Email (SMTP) for OTP verification on signup. Leave SMTP_HOST/SMTP_USER blank to
# run in demo mode: the verification code is shown on the page / logged instead of
# emailed. SMTP_USE_SSL (implicit TLS, e.g. port 465) overrides SMTP_USE_TLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
OTP_TTL_MINUTES=10

# Push alerts: when a price alert triggers, notifications are fanned out to any
# configured channel (Telegram, Discord) plus email via SMTP above.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=

# AI analyst report: set one of these to have the results page call a real LLM.
# Without keys the app falls back to a deterministic rule-based summary.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Advanced analytics tuning (optional, sensible defaults shown)
DRIFT_THRESHOLD=0.25
BACKTEST_DEFAULT_CASH=10000.0
BACKTEST_COMMISSION=0.001
BACKTEST_SLIPPAGE=0.0005
MONTE_CARLO_PATHS=1000
RISK_FREE_RATE=0.02
