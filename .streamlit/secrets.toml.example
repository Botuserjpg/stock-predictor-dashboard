# Streamlit secrets template for Stock Predictor Pro
#
# For local development: copy this file to `.streamlit/secrets.toml` (or use a
# `.env` file) and fill in the keys you need. The secrets file is git-ignored.
#
# For Streamlit Cloud deployment: paste the contents below into
#   https://share.streamlit.io/ -> your app -> Settings / Advanced settings -> Secrets
# (or the newer "Secrets" section under your deployment), then Deploy.
#
# Any key left blank simply disables that optional provider; the app degrades
# gracefully where possible. Keys shown as `YOUR_*` placeholders are optional
# and can be omitted entirely.

# Financial data providers
NEWSAPI_KEY=""
ALPHAVANTAGE_KEY=""
FINNHUB_KEY=""
FMP_KEY=""
POLYGON_KEY=""
TIINGO_KEY=""

# Social / sentiment providers
TWITTER_BEARER_TOKEN=""
REDDIT_CLIENT_ID=""
REDDIT_CLIENT_SECRET=""
REDDIT_USERNAME=""
REDDIT_PASSWORD=""

# Optional alternative data providers (can be omitted)
RAVENPACK_KEY="YOUR_RAVENPACK_KEY_HERE"
ACCERN_KEY="YOUR_ACCERN_KEY_HERE"

# Email (SMTP) for OTP verification. Leave blank to run in demo mode where the
# verification code is shown on the page instead of being emailed.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""
SMTP_USE_TLS="true"
SMTP_USE_SSL="false"
OTP_TTL_MINUTES="10"

# Optional push-alert channels
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
DISCORD_WEBHOOK_URL=""

# Optional LLM analyst report providers (rule-based fallback if unset)
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
